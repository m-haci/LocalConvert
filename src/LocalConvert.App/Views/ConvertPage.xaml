<Page
    x:Class="LocalConvert.App.Views.ConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" Padding="40,24,40,48" Spacing="20">
            <TextBlock x:Uid="Convert_Title" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="Convert_Subtitle" Style="{StaticResource BodyTextBlockStyle}" Opacity="0.8" TextWrapping="Wrap" />
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tools}" ItemTemplate="{StaticResource ToolCardTemplate}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="260" MinItemHeight="96" MinColumnSpacing="12" MinRowSpacing="12" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
